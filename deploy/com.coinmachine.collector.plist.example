<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.coinmachine.collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/yourname/coin_machine/.venv/bin/python</string>
        <string>/Users/yourname/coin_machine/src/main.py</string>
        <string>--mode</string>
        <string>once</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/yourname/coin_machine</string>
    <key>StandardOutPath</key>
    <string>/Users/yourname/coin_machine/logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yourname/coin_machine/logs/launchd_stderr.log</string>
</dict>
</plist>
